{
  // Cloudflare Workers 배포 설정.
  //
  // 코드가 도는 Worker가 아니라 정적 파일만 올리는 형태다. 그래서 `main`(진입점)이 없다.
  // 정적 파일 요청은 Worker 실행으로 치지 않아 무료 요청 한도를 쓰지 않는다.
  //
  // 빌드 결과물은 out/ 이고, 이 폴더는 `npm run build`가 만든다.
  // 대시보드의 Deploy command 는 `npx wrangler deploy` 그대로 두면 이 파일을 읽는다.

  "name": "aam-blog",
  "compatibility_date": "2026-07-31",

  "assets": {
    "directory": "./out",

    // 없는 주소는 Next.js가 만든 404.html 을 보여준다.
    // single-page-application 으로 두면 모든 주소가 200을 반환해
    // 검색엔진이 없는 글을 정상 페이지로 오해한다.
    "not_found_handling": "404-page",

    // /blog/글제목/ 처럼 슬래시로 끝나는 주소를 폴더의 index.html 로 연결한다.
    // next.config.mjs 의 trailingSlash: true 와 짝을 이룬다.
    "html_handling": "auto-trailing-slash"
  }
}
