# ── 사이트 주소 (필수) ─────────────────────────────────────
# 최종적으로 글이 노출될 도메인. canonical·사이트맵·JSON-LD에 쓰인다.
# 운영 주소가 기본값으로 코드에 들어 있어(src/config/site.ts), 이 파일이
# 없어도 빌드는 올바른 주소로 나간다. 도메인을 바꿀 때만 고친다.
NEXT_PUBLIC_SITE_URL=https://blog.aamkorea.co.kr


# ── 검색엔진 소유 확인 (선택) ────────────────────────────────
# 서치콘솔·서치어드바이저에 사이트를 등록하면 받는 값. 비우면 태그가 나가지 않는다.
# NEXT_PUBLIC_GOOGLE_VERIFY=
# NEXT_PUBLIC_NAVER_VERIFY=


# ── 방문자 분석 (선택) ──────────────────────────────────────
# Cloudflare Web Analytics 비콘 토큰과 GA4 측정 ID. 비우면 스크립트가 나가지 않는다.
# 홈페이지(aamkorea.co.kr)에서 GA를 쓰고 있다면 같은 측정 ID를 넣어야
# 블로그를 읽고 홈페이지로 넘어간 사람이 한 사람으로 이어진다.
# NEXT_PUBLIC_CF_BEACON_TOKEN=
# NEXT_PUBLIC_GA_ID=


# ── 채널톡 (선택) ──────────────────────────────────────────
# 상담 위젯 플러그인 키. 비밀값이 아니라 공개 HTML에 박히는 값이다.
# 비워 두면 위젯이 로드되지 않고, 문의 버튼은 홈페이지 문의 페이지로 연결된다.
# NEXT_PUBLIC_CHANNEL_PLUGIN_KEY=


# ── 노션 연동 (선택, 현재 미사용) ───────────────────────────
# 비워두면 content/posts/*.md 를 글 저장소로 쓴다.
# NOTION_TOKEN=
# NOTION_DATABASE_ID=
